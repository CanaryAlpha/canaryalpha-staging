{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/dashboard/report/",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>[a-z0-9][a-z0-9-]{0,63})"
        }
      ],
      "destination": "/reports/:slug/",
      "permanent": false
    },
    {
      "source": "/dashboard/report/",
      "destination": "/reports/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/reports/",
      "destination": "/api/pages/reports/"
    },
    {
      "source": "/reports/:slug/",
      "destination": "/api/pages/report/?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap/"
    }
  ],
  "functions": {
    "api/pages/*.js": {
      "includeFiles": "data/holdings.json"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        }
      ]
    },
    {
      "source": "/globe-demo/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(self)"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(dashboard|account|api)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/reports/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/reports",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
